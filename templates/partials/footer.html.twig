<footer id="footer" class="section section-tight">
    <div class="container">
        <div class="footer-brand">
            {% include 'partials/logo.html.twig' %}
        </div>
        {% if theme_var('footer-links') %}
        <nav class="footer-links" aria-label="Footer">
            {% for link in theme_var('footer-links') %}
                <a href="{{ link.url }}">{{ link.text }}</a>
            {% endfor %}
        </nav>
        {% endif %}
