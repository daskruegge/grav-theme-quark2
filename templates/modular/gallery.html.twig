{% set data = page.header.gallery|default({}) %}
{% set thumb_width = data.thumb.width|default(600) %}
{% set thumb_height = data.thumb.height|default(450) %}

<section class="section modular-gallery">
    <div class="container">
        {{ content|raw }}
        <div class="practice-gallery-grid">
            {% for item in data.items|default([]) %}
                {% set item_image = item.image ? page.media[item.image] : null %}
                {% if item_image %}
                    {% set thumbnail = item_image.cropZoom(thumb_width, thumb_height) %}
                    <figure class="practice-gallery-item">
                        <a href="{{ item_image.url }}">
                            <img src="{{ thumbnail.url }}" alt="{{ item.title|default('')|e('html_attr') }}" loading="lazy">
                        </a>
                        {% if item.title or item.desc %}
                        <figcaption>
                            {% if item.title %}<strong>{{ item.title }}</strong>{% endif %}
                            {% if item.desc %}<div>{{ item.desc|markdown(false) }}</div>{% endif %}
                        </figcaption>
                        {% endif %}
                    </figure>
                {% endif %}
            {% endfor %}
        </div>
    </div>
</section>
